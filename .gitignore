# Built application files
*.apk
*.aab
*.ap_
*.aar

# Files for the Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/

# Gradle files
.gradle/
build/
/*/build/
/*/*/build/
.kotlin/

# Local configuration file (sdk path, etc) - machine-specific, never commit
local.properties

# Log/profiling files
*.log
*.hprof

# Android Studio / IntelliJ project files - regenerated by the IDE, should not be committed
*.iml
.idea/
.navigation/
captures/
.externalNativeBuild/
.cxx/

# Signing configs / keystores - never commit real signing material
*.jks
*.keystore
keystore

# Project specific files
authors.txt

# OS-specific junk files
.DS_Store
Thumbs.db
